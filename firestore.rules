rules_version = '2';

// Paste this into Firebase: Firestore Database → Rules → Publish.
//
// Each Secret Santa group gets a long random code that's part of its wishlist
// link. Anyone with the link can add or edit wishlists in that group, and
// nothing else in the database can be read or changed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId}/wishlists/{personId} {
      allow read, delete: if groupId.size() >= 10;

      allow create, update: if groupId.size() >= 10
        && request.resource.data.keys().hasOnly(['name', 'ideas', 'likes', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ideas is string
        && request.resource.data.ideas.size() <= 600
        && request.resource.data.likes is string
        && request.resource.data.likes.size() <= 600
        && request.resource.data.updatedAt is int;
    }
  }
}
